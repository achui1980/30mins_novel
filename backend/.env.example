# 30分钟读懂一本书 — backend 环境变量模板
#
# 复制为 backend/.env 后按需修改。已有环境变量优先于本文件
# （config.py 的 _load_dotenv: 命令行/环境里已存在的值不会被覆盖）。
# 所有变量前缀 NOVEL_KG_，含义见 README「后端」配置表。

# --- 离线演示（无需任何大模型 key）----
NOVEL_KG_USE_FAKE_LLM=0

# --- LLM provider（默认 bedrock）----
# 可选值：
#   bedrock            -> AWS Strands 调用 Amazon Bedrock（默认）
#   openai_compatible  -> 任意 OpenAI 兼容端点（如 DeepSeek）
NOVEL_KG_LLM_PROVIDER=bedrock

# --- Bedrock（provider=bedrock 时生效）----
# NOVEL_KG_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# NOVEL_KG_BEDROCK_REGION=us-east-1

# --- OpenAI 兼容端点（provider=openai_compatible 时生效）----
# 接入 DeepSeek：填入你的 API key 即可，其余项用默认值。
NOVEL_KG_OPENAI_COMPATIBLE_API_KEY=
# NOVEL_KG_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
# NOVEL_KG_OPENAI_COMPATIBLE_MODEL_ID=deepseek-v4-flash
# DeepSeek V4 默认开 thinking（更慢更贵），默认关闭
# NOVEL_KG_OPENAI_COMPATIBLE_THINKING=0
# NOVEL_KG_OPENAI_COMPATIBLE_MAX_TOKENS=8192
# 单次 HTTP 调用超时（秒）
# NOVEL_KG_OPENAI_COMPATIBLE_TIMEOUT=120

# --- 存储 / 抽取（可选调优）----
# NOVEL_KG_DATA_ROOT=/absolute/path/to/data/works
# NOVEL_KG_MAX_UPLOAD_BYTES=26214400
# NOVEL_KG_EXTRACT_CONCURRENCY=5
# NOVEL_KG_EXTRACT_MAX_RETRIES=4
# NOVEL_KG_EXTRACT_BACKOFF_BASE=1.5
